<idea-plugin>
    <id>com.crossguild.difffrog</id>
    <name>difffrog</name>
    <vendor>ZoLitaTek</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>
    <description>DiffFrog is an IntelliJ plugin that helps developers visually compare files and
        detect differences quickly, improving productivity during code reviews and debugging.</description>

    <actions>
        <action id="com.crossguild.difffrog.GitDiffToolbarAction"
                class="com.crossguild.difffrog.GitDiffToolbarAction"
                text="Git Diff Stats">
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
            <add-to-group group-id="NavBarToolBar" anchor="last"/>
            <add-to-group group-id="MainToolbar" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable instance="com.crossguild.difffrog.config.DiffFrogConfigurable"
                                 id="com.crossguild.difffrog.settings"
                                 displayName="DiffFrog"/>

        <toolWindow id="DiffFrog" anchor="right" icon="/icons/toolWindow.svg"
                    factoryClass="com.crossguild.difffrog.toolwindow.DiffFrogToolWindowFactory"/>

        <notificationGroup id="DiffFrog" displayType="BALLOON"/>
    </extensions>

</idea-plugin>
